#!/usr/bin/sh
# @author nate zhou
# @since 2025,2026
# river-classic/autostart

spawn="riverctl spawn"

# make the Wayland session visible to systemd user services
# (xdg-desktop-portal needs WAYLAND_DISPLAY to open file pickers)
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true

# always
$spawn "${HOME}/.local/bin/dam-run river-classic" &

# restart
killall -q swaybg fcitx5 mpc &

$spawn "swaybg -i ${HOME}/.local/share/wallpaper -m fill" &
#$spawn "swaybg -c 000000" &

# restart decided by scripts
$spawn "${HOME}/.local/bin/foots" &

#$spawn "${HOME}/.local/bin/lucia -d" &   # AI assistant not configured on this machine

$spawn "${HOME}/.local/bin/mbs-cron" &

# start if not running
pgrep 'swayidle' || $spawn "swayidle -w" &

pgrep 'kanshi' || $spawn "kanshi" &

pgrep -x mpd || $spawn "mpd" &

# xwayland-satellite: X server for X11 apps (qq, etc.) under river-classic
pgrep -f 'xwayland-satellite' || $spawn "env DISPLAY=:0 xwayland-satellite" &

pgrep -f 'wl-paste --watch cliphist store' || $spawn "wl-paste --watch cliphist store" &

pgrep 'dunst' || $spawn "dunst" &

pgrep 'wob' || $spawn "${HOME}/.local/bin/wobd" &

$spawn "fcitx5 -d --verbose '*=0'" & # conflicts with wtype
