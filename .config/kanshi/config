# vim:ft=config
# kanshi/config
# @author nate zhou
# @since 2025,2026

profile nomad {
    output eDP-1 mode --custom 2560x1440@165.003Hz scale 1.2
}

profile home {
    output eDP-1 mode --custom 2560x1440@165.003Hz position 0,0
    output DP-1 enable mode --custom 1920x1080@60Hz position 1920,0
}

profile home {
    output eDP-1 mode --custom 2560x1440@165.003Hz position 0,0
    output DP-2 enable mode --custom 1920x1080@60Hz position 1920,0
}

profile hdmi {
    output eDP-1 mode --custom 2560x1440@165.003Hz position 0,0
    output HDMI-A-1 enable position 2560,0
}
