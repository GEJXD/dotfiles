#!/usr/bin/sh
# @author nate zhou
# @since 2023,2025,2026
# pomodoro - cli pomodoro with a fixed Work : Break = 5 : 1

start_time="$(date +%s)"
work_minute="$1"
break_minute=0

usage() {
    cat <<_EOF_
Usage
        $(basename "$0") MINUTES
        Work : Break = 5 : 1
Example
        $(basename "$0") 25
        Work for 25 minutes, then notify to take a 5 minute break
_EOF_
    exit 1;
}

notify() {
    msg="$1"

    [ "$XDG_SESSION_TYPE" != "tty" ]\
        && notify-send -u critical -t 0 -r 2002 "$(basename $0)" "$msg"
}

abort() {
    msg="$1"

    RED='\033[0;31m'
    RESET='\033[0m'

    printf "${RED}%s${RESET}\n" "$msg" >&2

    notify "$msg"
    exit 1
}

ceiling() {
    # ceiling to nearest 5
    echo $(( ( ($1 + 4) / 5 ) * 5  ))
}

start() {
    work_seconds=$(( work_minute * 60 ))
    break_minute=$(ceiling $(( work_minute / 5 )) )

    echo "Work = ${work_minute}min, Break = ${break_minute}min"

    while [ $(($(date +%s) - start_time)) -lt $work_seconds ]; do
        elapsed_minute=$(( ($(date +%s) - $start_time) / 60 ))
        printf "\r${elapsed_minute} of $work_minute minutes passed"
        sleep 60
    done && printf "\n"

    echo "$work_minute minutes passed, take a ${break_minute} minute break!"
    notify "$work_minute minutes passed,\n take a ${break_minute} minute break!"
}

if [ -z "$1" ]; then
    usage
elif [ "$#" -ne 1 ]; then
    abort "too many arguments"
else
    if case "$1" in *[!0-9]*|0) true ;; *) false ;; esac; then
        abort "argument must be a positive integer"
    else
        start
    fi
fi
