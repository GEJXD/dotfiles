#!/usr/bin/env bash
# @author nate zhou
# @since 2024,2025,2026

# sync-config-sys - copy the tracked system files in /etc back into the repository

# ~/.local/bin is a symlink into the repository, so the checkout can live anywhere
repo="$(CDPATH= cd -P -- "$(dirname -- "$0")/../.." && pwd)"

read -p "Continue? (y/n): " choice
if [[ "$choice" == "y" || "$choice" == "Y" ]]; then

    rsync -pvh --progress -R \
        /boot/loader/{entries/*,loader.conf} \
        /etc/{mkinitcpio.conf,samba/smb.conf,fwupd/fwupd.conf,ssh/sshd_config,systemd/{logind.conf,sleep.conf},tlp.conf,vconsole.conf,libvirt/network.conf,pacman.conf,pacman.d/{mirrorlist,hooks/*},xdg/reflector/reflector.conf} \
        /usr/local/share/kbd/keymaps/us-custom.map.gz \
        "$repo"/

else
    echo "aborted"
    exit 0
fi
