#!/usr/bin/sh
# @author nate zhou
# @since 2024,2025,2026
# sync-config - write the per-host package lists, crontab backup and address excerpt

# ~/doc/heart holds machine-local state around the repository: the package lists
# read by install-root.sh and the files the cron jobs write to.
heart="${HOME}/doc/heart"
hostname="$(cat /etc/hostname)"

chmod 700 "$heart" # deny go permission to exclude for termux syncing

# under cron there is no terminal to answer on, and nothing here is destructive
read -p "Continue? (y/n): " choice || choice="y"
if [ "$choice" = "y" ] || [ "$choice" = "Y" ]; then
    mkdir -p "${heart}/package-list"
    pacman -Qmq | sort > "${heart}/package-list/aur-${hostname}.list" &
    pacman -Qenq | sort > "${heart}/package-list/arch-${hostname}.list" &
    command -v code >/dev/null 2>&1 \
        && command code --list-extensions > "${heart}/package-list/code-${hostname}.list" 2>/dev/null &

    # sync-config-cron throttles on this file and install-user.sh installs it
    crontab -l > "${HOME}/.config/crontab.backup" \
        && echo "crontab backup done" || echo "crontab backup failed"

    # censor address book for screen casting
    address="${HOME}/.local/share/address/address"
    if [ -f "$address" ]; then
        grep -n "##############################below-are-private##############################" \
            "$address" \
            | cut -d: -f1 \
            | xargs -I {} sed -n '1,{}p' "$address" \
            > "${address}-record" \
            && echo "address-record updated" || echo "address-record update failed"
    fi

    wait
else
    echo "aborted"
    exit 0
fi
