#!/usr/bin/env bash
# @author nate zhou
# @since 2024,2025,2026
# list updatable packages through xdg notification
# @depends pacman-contrib ~/.local/bin/checkupdates-cron

# This script has completions: `.config/{z,ba}sh/completions/_scripts.{z,ba}sh`

LOG_CACHE="${HOME}/.cache/checkupdates-cron.log"
ERR_CACHE="${HOME}/.cache/checkupdates-cron.err"

get_all() {
    mode="all"
    pkg_list="$(cat $LOG_CACHE)"
}

get_explicit() {
    mode="explicit"
    pkg_list="$(comm -12 <(cat $LOG_CACHE) <(pacman -Qeq | sort))"
}

get_dependency() {
    mode="dependency"
    pkg_list="$(comm -12 <(cat $LOG_CACHE) <(pactree $1 -u | sort))"
}

get_default() {
    mode="default"
    local pkg=(base base-devel linux linux-headers)

    local default_list="$default_list $(pacman -Qeq)"
    default_list+=$'\n'$(printf '%s\n' "${pkg[@]}" \
        | xargs -P4 -I{} pactree -u {} 2>/dev/null)
    default_list=$(printf '%s\n' "$default_list" | sort -u)

    pkg_list="$(comm -12 <(cat "$LOG_CACHE") <(printf '%s\n' "$default_list"))"
}

count_updates() {
    pkg_count="$(echo $pkg_list | wc -w)"
}

print_err() {
    cat $ERR_CACHE
}

notify() {
    title="(${pkg_count} $mode)"
    printf "%s\n%s\n" "$title" "${pkg_list//$'\n'/ }"

    if [ "$XDG_SESSION_TYPE" != "tty" ]; then
        notify-send -u low -r 181 \
                    "$(basename "$0")${title}" \
                    "${pkg_list//$'\n'/ }"
    fi
}

[ ! -f "$LOG_CACHE" ] && (${HOME}/.local/bin/checkupdates-cron || print_err)

[ -z "$1" ] && get_default

while [ -n "$1" ]; do
    case "$1" in
        -e|--explicit) get_explicit ;;
        -a|--all) get_all ;;
        *) get_dependency "$1";;
    esac
    shift
done

count_updates

notify
