#!/usr/bin/env bash
# @author nate zhou
# @since 2024,2025,2026
# list updatable packages through xdg notification
# @depends pacman-contrib ~/.local/bin/checkupdates-cron

# This script has completions: `.config/{z,ba}sh/completions/_scripts.{z,ba}sh`

LOG_CACHE="${HOME}/.cache/checkupdates-cron.log"
ERR_CACHE="${HOME}/.cache/checkupdates-cron.err"

get_all() {
    mode="all"
    pkg_list="$(cat $LOG_CACHE)"
}

get_explicit() {
    mode="explicit"
    pkg_list="$(comm -12 <(cat $LOG_CACHE) <(pacman -Qeq | sort))"
}

get_dependency() {
    mode="dependency"
    pkg_list="$(comm -12 <(cat $LOG_CACHE) <(pactree $1 -u | sort))"
}

count_updates() {
    pkg_count="$(echo $pkg_list | wc -w)"
}

get_default() {
    get_explicit
}

print_err() {
    cat $ERR_CACHE
}

notify() {
    title="(${pkg_count} $mode)"
    printf "%s\n%s\n" "$title" "$pkg_list" | less -F
    [ "$XDG_SESSION_TYPE" != "tty" ] \
        && notify-send -u low -r 181 "$(basename $0)${title}" "${pkg_list}"
}

[ ! -f "$LOG_CACHE" ] && (${HOME}/.local/bin/checkupdates-cron || print_err)

[ -z "$1" ] && get_default

while [ -n "$1" ]; do
    case "$1" in
        -e|--explicit) get_explicit ;;
        -a|--all) get_all ;;
        *) get_dependency "$1";;
    esac
    shift
done

count_updates

notify
