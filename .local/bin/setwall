#!/usr/bin/sh
# @author nate zhou
# @since 2023,2024,2025,2026
# @depends swaybg xwallpaper(xorg)
# setwall - set wallpaper

WALLPAPER="${HOME}/.local/share/wallpaper"

if [ ! -f "$1" ]; then
    echo "setwall: no such file: $1" >&2
    exit 1
fi
ln -sfn "$(realpath "$1")" "$WALLPAPER"

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    killall swaybg
    nohup swaybg -i "$WALLPAPER" -m fill >/dev/null 2>&1 &
elif [ -n "$XAUTHORITY" ]; then
    xwallpaper --zoom "$WALLPAPER"
fi
