#!/usr/bin/sh
# @author nate zhou
# @since 2024,2025,2026
# @depends xsetwall nsxiv swaybg swayimg
# select an image to wallpaper in X11 and Wayland

WALLPAPER_DIR="${HOME}/pic/wallpapers"
LIST="${XDG_RUNTIME_DIR}/gallery.list"

notify() {
    notify-send -u low -r 438 "$@"
}

if [ ! -d "$WALLPAPER_DIR" ]; then
    notify "no ${WALLPAPER_DIR}"
    exit 1
fi

# videos never become a wallpaper, swayimg and nsxiv would only choke on them
find "$WALLPAPER_DIR" -type f ! -name '*.mp4' ! -name '*.webm' \
    | shuf > "$LIST"

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    notify "[Shift+w] to set wallpaper"
    swayimg --appid='Floating_IMG' -g -f "$LIST"
elif [ -n "$XAUTHORITY" ]; then
    notify "[Ctrl-x w] to set wallpaper"
    nsxiv -N "Floating_IMG" -t - < "$LIST"
fi
