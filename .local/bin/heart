#!/usr/bin/sh
# @author nate zhou
# @since 2024,2025,2026
# heart - search and edit dotfiles tracked by git in a dynamic menu
# It's called heart because all my dotfiles are under ~/doc/heart managed by stow.

# Resolve the repository from this script's own location, so the checkout can
# live anywhere: ~/.local/bin is a symlink into the repository.
repo="$(CDPATH= cd -P -- "$(dirname -- "$0")/../.." && pwd)"
menu_prompt="$(basename $0)"

if [ "$TERM" = "dvtm-256color" ] ; then
    term=""
    EDITOR="command vim"
elif [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    term="footclient"
    menu="${HOME}/.local/bin/wmenu-color"
elif [ -n "$XAUTHORITY" ]; then
    term="st"
    menu="dmenu"
else
    term=""
    EDITOR="command vim"
fi

list_tracked_files() {
    git -C "$repo" ls-tree -r HEAD --name-only \
        | grep -ve .png$ \
               -ve .local/share/lockscreen$ \
               -ve ^LICENSE$ \
               -ve .md$ \
               -ve .list$ \
        | sort
}

menu() {
    if [ -n "$menu" ]; then
        $menu -p "heart" -i -l 6
    else
        fzf --prompt "$menu_prompt"
    fi
}

selected_file="$(list_tracked_files | menu)"

[ -n "$selected_file" ] && $term $EDITOR "$repo/$selected_file"
